# Set this variable to 'true' to use the production API (Heroku server).
# Set it to 'false' or leave it unset to use the local development API.
REACT_APP_USE_PRODUCTION_API=false

# Local development API URL
REACT_APP_DEV_URL=http://localhost:8000/api

# Production API URL. Must share a site with the app (gaitobservatory.com) so the
# browser sends Gait's HttpOnly refresh cookie; the herokuapp.com host is cross-site.
REACT_APP_PRODUCTION_URL=https://api.gaitobservatory.com/api
